<Window x:Class="ProxyWin.App.ProxyDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Proxy server" Width="450" Height="365" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource {x:Type Window}}">
  <Grid Margin="16"><Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Proxy server" FontSize="18" FontWeight="Bold" />
      <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,8,0"><TextBlock Text="Name" Style="{StaticResource Label}" /><TextBox x:Name="NameBox" MaxLength="80" /></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="Type" Style="{StaticResource Label}" /><ComboBox x:Name="KindBox"><ComboBoxItem Content="SOCKS5 · TCP/UDP" /><ComboBoxItem Content="HTTP · TCP" /></ComboBox></StackPanel>
      </Grid>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="84" /></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,8,0"><TextBlock Text="Host" Style="{StaticResource Label}" /><TextBox x:Name="HostBox" MaxLength="253" /></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="Port" Style="{StaticResource Label}" /><TextBox x:Name="PortBox" MaxLength="5" /></StackPanel>
      </Grid>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,8,0"><TextBlock Text="Username (optional)" Style="{StaticResource Label}" /><TextBox x:Name="UserBox" MaxLength="255" /></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="Password (optional)" Style="{StaticResource Label}" /><PasswordBox x:Name="PasswordBox" MaxLength="255" /></StackPanel>
      </Grid>
      <TextBlock Text="Credentials are encrypted for your Windows account.&#x0a;UDP requires SOCKS5 UDP ASSOCIATE." FontSize="10" Foreground="{StaticResource Muted}" Margin="0,10,0,0" LineHeight="16" />
    </StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" IsCancel="True" Margin="0,0,6,0" /><Button Content="Save" Style="{StaticResource Primary}" IsDefault="True" Click="Save" /></StackPanel>
  </Grid>
</Window>
